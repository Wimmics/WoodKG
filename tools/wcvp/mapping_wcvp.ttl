@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix xrr: <http://i3s.unice.fr/xr2rml#> .

@prefix dwc: <http://rs.tdwg.org/dwc/terms/> .
@prefix schema: <http://schema.org/> .
@prefix wcvpp: <http://ns.inria.fr/wcvp/property/> .

<#Taxon> a rr:TripleMap ;
  xrr:logicalSource [ xrr:query """db.collection.find({taxonomicstatus: "Accepted"})""" ] ;
  rr:subjectMap [
    rr:template "http://ns.inria.fr/wcvp/taxon/{$.taxonid}" ;
    rr:class skos:Concept ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate skos:broader ;
    rr:objectMap [ rr:template "http://ns.inria.fr/wcvp/taxon/{$.parentnameusageid}" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate dwc:taxonID ;
    rr:objectMap [ xrr:reference "$.taxonid" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate skos:prefLabel ;
    rr:objectMap [ xrr:reference "$.scientfiicname" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate dwc:taxonRank ;
    rr:objectMap [ xrr:reference "$.taxonrank" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate wcvpp:hasReferenceName ;
    rr:objectMap [ rr:template "http://ns.inria.fr/wcvp/name/{$.taxonid}" ] ;
  ] ;
  
  # Additional DwC classification terms
  rr:predicateObjectMap [
    rr:predicate dwc:family ;
    rr:objectMap [ xrr:reference "$.family" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate dwc:genus ;
    rr:objectMap [ xrr:reference "$.genus" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate dwc:specificEpithet ;
    rr:objectMap [ xrr:reference "$.specificepithet" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate dwc:infraspecificEpithet ;
    rr:objectMap [ xrr:reference "$.infraspecificepithet" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:mainEntityOfPage ;
    rr:objectMap [ xrr:reference "$.references" ] ;
  ] .

<#AllNames> a rr:TripleMap ;
  xrr:logicalSource [ xrr:query """db.collection.find({})""" ] ;
  rr:subjectMap [
    rr:template "http://ns.inria.fr/wcvp/name/{$.taxonid}" ;
    rr:class skos:Concept ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate skos:prefLabel ;
    rr:objectMap [
      rr:template "{$.scientfiicname} {$.scientfiicnameauthorship}" ;
      rr:termType rr:Literal ;
    ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate dwc:scientificName ;
    rr:objectMap [ xrr:reference "$.scientfiicname" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate dwc:scientificNameAuthorship ;
    rr:objectMap [ xrr:reference "$.scientfiicnameauthorship" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate dwc:namePublishedIn ;
    rr:objectMap [ xrr:reference "$.namepublishedin" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate dwc:scientificNameID ;
    rr:objectMap [ xrr:reference "$.taxonid" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate dwc:taxonRank ;
    rr:objectMap [ xrr:reference "$.taxonrank" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate dwc:taxonomicStatus ;
    rr:objectMap [ xrr:reference "$.taxonomicstatus" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate wcvpp:hasTaxonomicStatus ;
    rr:objectMap [ rr:template "http://ns.inria.fr/wcvp/taxonomicStatus/{$.taxonomicstatus}" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate skos:broader ;
    rr:objectMap [ rr:template "http://ns.inria.fr/wcvp/name/{$.parentnameusageid}" ] ;
  ] ;
  
  # Additional DwC classification terms
  rr:predicateObjectMap [
    rr:predicate dwc:family ;
    rr:objectMap [ xrr:reference "$.family" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate dwc:genus ;
    rr:objectMap [ xrr:reference "$.genus" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate dwc:specificEpithet ;
    rr:objectMap [ xrr:reference "$.specificepithet" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate dwc:infraspecificEpithet ;
    rr:objectMap [ xrr:reference "$.infraspecificepithet" ] ;
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:mainEntityOfPage ;
    rr:objectMap [ xrr:reference "$.references" ] ;
  ] .

# ==================== Link Taxa and Names ====================
<#LinkTaxonToSynonym> a rr:TripleMap ;
  xrr:logicalSource [ xrr:query """db.collection.find({taxonomicstatus: "Synonym"})""" ] ;
  rr:subjectMap [ rr:template "http://ns.inria.fr/wcvp/taxon/{$.acceptednameusageid}" ] ;
  rr:predicateObjectMap [
    rr:predicate wcvpp:hasSynonym ;
    rr:objectMap [ rr:template "http://ns.inria.fr/wcvp/name/{$.taxonid}" ] ;
  ] .

# Link names where taxonomic status is none of "Synonym" or "Accepted", to the accepted name
<#LinkNameTaxon> a rr:TripleMap ;
  xrr:logicalSource [
    xrr:query """db.collection.find({$and: [ {taxonomicstatus: {$ne: "Accepted"}}, {taxonomicstatus: {$ne: "Synonym"}} ]})"""
  ] ;
  rr:subjectMap [ rr:template "http://ns.inria.fr/wcvp/name/{$.taxonid}" ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:seeAlso ;
    rr:objectMap [ rr:template "http://ns.inria.fr/wcvp/name/{$.acceptednameusageid}" ] ;
  ] .

# ==================== Taxonomic ranks of taxa and names ====================

<#TaxonRank> a rr:TripleMap ;
  xrr:logicalSource [
    xrr:query """db.collection.find({ $and: [{taxonomicstatus: "Accepted"}, {$or: [{taxonrank: "Forma"}, {taxonrank: "Genus"}, {taxonrank: "Species"}, {taxonrank: "SubForma"}, {taxonrank: "SubSpecies"}, {taxonrank: "SubVarietas"}, {taxonrank: "Varietas"}] }]})""" ;
  ] ;
  rr:subjectMap [ rr:template "http://ns.inria.fr/wcvp/taxon/{$.taxonid}" ] ;
  rr:predicateObjectMap [
    rr:predicate wcvpp:hasRank ;
    rr:objectMap [ rr:template "http://taxref.mnhn.fr/lod/taxrank/{$.taxonrank}" ] ;
  ] .

<#NameRank> a rr:TripleMap ;
  xrr:logicalSource [
    xrr:query """db.collection.find({$or: [{taxonrank: "Forma"}, {taxonrank: "Genus"}, {taxonrank: "Species"}, {taxonrank: "SubForma"}, {taxonrank: "SubSpecies"}, {taxonrank: "SubVarietas"}, {taxonrank: "Varietas"}] })""" ;
  ] ;
  rr:subjectMap [ rr:template "http://ns.inria.fr/wcvp/name/{$.taxonid}" ] ;
  rr:predicateObjectMap [
    rr:predicate wcvpp:hasRank ;
    rr:objectMap [ rr:template "http://taxref.mnhn.fr/lod/taxrank/{$.taxonrank}" ] ;
  ] .