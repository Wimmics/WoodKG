@prefix xrr: <http://i3s.unice.fr/xr2rml#> .
@prefix rr:  <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix txrfp: <http://taxref.mnhn.fr/lod/property/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix pl_tax: <http://www.plant-taxonomy-kg.com/core#> .
@prefix taxref: <http://taxref.mnhn.fr/lod/resource/> .

<#accepted>
  a rr:TripleMap;
  xrr:logicalSource [
    xrr:query """db.collection.find({ taxonomicstatus: "Accepted" })""";
  ];
  rr:subjectMap [
    rr:template "http://www.wcvp-core.com/taxon/{$.taxonid}";
    rr:class owl:Class;
  ];
  rr:predicateObjectMap [
    rr:predicate rdfs:subClassOf;
    rr:objectMap [
      rr:template "http://www.wcvp-core.com/taxon/{$.parentnameusageid}";
    ];
  ];
  rr:predicateObjectMap [
    rr:predicate txrfp:taxonRank;
    rr:objectMap [
      rr:template "http://taxref.mnhn.fr/lod/taxrank/{$.taxonrank}";
    ];
  ];
  rr:predicateObjectMap [
    rr:predicate txrfp:hasReferenceName;
    rr:objectMap [
      rr:template "http://www.wcvp-core.com/name/{$.taxonid}";
    ];
  ].


<#Name>
  a rr:TripleMap;
  xrr:logicalSource [
    xrr:query """db.collection.find({})""";
  ];
  rr:subjectMap [
    rr:template "http://www.wcvp-core.com/name/{$.taxonid}";
    rr:class skos:Concept;
  ];
  rr:predicateObjectMap [
    rr:predicate rdfs:label;
    rr:objectMap [
      xrr:reference "$.scientfiicname";
      rr:datatype xsd:string;
    ];
  ];
    rr:predicateObjectMap [
    rr:predicate txrfp:taxonRank;
    rr:objectMap [
      rr:template "http://taxref.mnhn.fr/lod/taxrank/{$.taxonrank}";
    ];
  ];
  rr:predicateObjectMap [
    rr:predicate taxref:hasAuthority;
    rr:objectMap [
      xrr:reference "$.scientfiicnameauthorship";
      rr:datatype xsd:string;
    ];
  ];
  rr:predicateObjectMap [
    rr:predicate owl:sameAs;
    rr:objectMap [
      xrr:reference "$.references";
    ];
  ];
  rr:predicateObjectMap [
    rr:predicate skos:broader;
    rr:objectMap [
      rr:template "http://www.wcvp-core.com/name/{$.parentnameusageid}";
    ];
  ].


<#synonym>
  a rr:TripleMap;
  xrr:logicalSource [
    xrr:query """db.collection.find({taxonomicstatus: { $ne: "Accepted" }})""";
  ];
  rr:subjectMap [
    rr:template "http://www.wcvp-core.com/taxon/{$.acceptednameusageid}";
    rr:class owl:Class;
  ];
  rr:predicateObjectMap [
    rr:predicate taxref:hasSynonym;
    rr:objectMap [
      rr:template "http://www.wcvp-core.com/name/{$.taxonid}";
    ];
  ].
