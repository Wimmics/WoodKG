@prefix xrr:    <http://i3s.unice.fr/xr2rml#> .
@prefix rr:     <http://www.w3.org/ns/r2rml#> .
@prefix rml:    <http://semweb.mmlab.be/ns/rml#> .

@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sosa:   <http://www.w3.org/ns/sosa/> .
@prefix sio:    <http://semanticscience.org/resource/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .


<#Observation>
  a rr:TripleMap;
  xrr:logicalSource [
    xrr:query """db.collection.find({})""";
  ];
  rr:subjectMap [
    rr:template "http://ns.inria.fr/woodkg/observation/{$.sampleID}/{$.Observationid}";
    rr:class sosa:Observation;
  ];
  rr:predicateObjectMap [
    rr:predicate sosa:hasFeatureOfInterest;
    rr:objectMap [ rr:template "http://ns.inria.fr/iawa/featureOfInterest/{$.feature_id}" ];
  ];
  rr:predicateObjectMap [
    rr:predicate sosa:observedProperty;
    rr:objectMap [ rr:template "http://ns.inria.fr/iawa/observableProperty/{$.property_id}" ];
  ];
  rr:predicateObjectMap [
    rr:predicate sosa:hasResult;
    rr:objectMap [ rr:template "http://ns.inria.fr/iawa/value/{$.iawa_val_key}" ];
  ].

<#Sample>
  a rr:TripleMap;
  xrr:logicalSource [
    xrr:query """db.collection.find({})""";
  ];
  rr:subjectMap [
    rr:template "http://ns.inria.fr/woodkg/sample/{$.sampleID}";
    rr:class sio:SIO_001050; # Sample
  ];
    rr:predicateObjectMap [
    rr:predicate sosa:hasObservation;
    rr:objectMap [ rr:template "http://ns.inria.fr/woodkg/observation/{$.sampleID}/{$.Observationid}" ];
  ];
    rr:predicateObjectMap [
    rr:predicate sio:SIO_000628; # refers to
    rr:objectMap [ rr:template "http://ns.inria.fr/wcvp/taxon/{$.taxonid}" ];
  ].
