@prefix xrr: <http://i3s.unice.fr/xr2rml#> .
@prefix rr:  <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix txrfp: <http://taxref.mnhn.fr/lod/property/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix pl_tax: <http://www.plant-taxonomy-kg.com/core#> .
@prefix taxref: <http://taxref.mnhn.fr/lod/resource/> .
@prefix sosa: <https://www.w3.org/TR/2017/REC-vocab-ssn-20171019/> .

<#Observation>
  a rr:TripleMap;
  xrr:logicalSource [
    xrr:query """
      db.collection.find({
      })
    """;
  ];
  rr:subjectMap [
    rr:template "http://observation/{$.sampleID}/{$.Observationid}";
    rr:class sosa:Observation;
  ];
  rr:predicateObjectMap [
    rr:predicate sosa:hasFeatureOfInterest;
    rr:objectMap [
      rr:template "https://featuresOfInterest/{$.FOIID}";
    ];
  ];
  rr:predicateObjectMap [
    rr:predicate sosa:observedProperty;
    rr:objectMap [
      rr:template "https://observedProperty/{$.OPID}";
    ];
  ];
  rr:predicateObjectMap [
    rr:predicate sosa:hasResult;
    rr:objectMap [
      rr:template "https://values/{$.VALID}";
    ];
  ].

<#Sample>
  a rr:TripleMap;
  xrr:logicalSource [
    xrr:query """
      db.collection.find({
      })
    """;
  ];
  rr:subjectMap [
    rr:template "http://sample/{$.sampleID}";
    rr:class pl_tax:sample;
  ];
    rr:predicateObjectMap [
    rr:predicate sosa:hasObservation;
    rr:objectMap [
      rr:template "http://observation/{$.sampleID}/{$.Observationid}";
    ];
  ];
    rr:predicateObjectMap [
    rr:predicate taxref:hasTaxon;
    rr:objectMap [
      rr:template "http://www.wcvp-core.com/taxon/{$.taxonid}";
    ];
  ].

