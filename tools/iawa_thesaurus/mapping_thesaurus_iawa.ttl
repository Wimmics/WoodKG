@prefix xrr:    <http://i3s.unice.fr/xr2rml#> .
@prefix rr:     <http://www.w3.org/ns/r2rml#> .
@prefix rml:    <http://semweb.mmlab.be/ns/rml#> .

@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .


<#FOI>
  a rr:TripleMap;
  xrr:logicalSource [
    xrr:query """db.collection.find({ type: "featuresOfInterest" })""";
  ];
  rr:subjectMap [
    rr:template "http://ns.inria.fr/iawa/featureOfInterest/{id}";
    rr:class skos:Concept;
  ];
  rr:predicateObjectMap [
    rr:predicate skos:prefLabel ;
    rr:objectMap [ xrr:reference "label_en"; rr:language "en" ] ;
  ];
  rr:predicateObjectMap [
    rr:predicate skos:prefLabel ;
    rr:objectMap [ xrr:reference "label_fr"; rr:language "fr" ] ;
  ].


<#OP>
  a rr:TripleMap;
  xrr:logicalSource [
    xrr:query """db.collection.find({ type: "observableProperties" })""";
  ];
  rr:subjectMap [
    rr:template "http://ns.inria.fr/iawa/observableProperty/{id}";
    rr:class skos:Concept;
  ];
  rr:predicateObjectMap [
    rr:predicate skos:prefLabel ;
    rr:objectMap [ xrr:reference "label_en"; rr:language "en" ] ;
  ];
  rr:predicateObjectMap [
    rr:predicate skos:prefLabel ;
    rr:objectMap [ xrr:reference "label_fr"; rr:language "fr" ] ;
  ].


<#VAL>
  a rr:TripleMap;
  xrr:logicalSource [
    xrr:query """db.collection.find({ type: "values" })""";
  ];
  rr:subjectMap [
    rr:template "http://ns.inria.fr/iawa/value/{id}";
    rr:class skos:Concept;
  ];
  rr:predicateObjectMap [
    rr:predicate skos:prefLabel ;
    rr:objectMap [ xrr:reference "label_en"; rr:language "en" ] ;
  ];
  rr:predicateObjectMap [
    rr:predicate skos:prefLabel ;
    rr:objectMap [ xrr:reference "label_fr"; rr:language "fr" ] ;
  ].
